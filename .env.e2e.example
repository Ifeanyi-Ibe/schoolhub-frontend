# Copy to .env.e2e (git-ignored) and fill in. Values below are placeholders only.
# Used by the real-backend journeys (e2e-real/). Development seed credentials are listed in
# docs/backend/DEV_SEED.md (copied from the backend repository).

# The backend's base URL and the BFF key it was started with (at least 32 characters).
E2E_API_BASE_URL=http://localhost:5152
E2E_BFF_KEY=replace-with-the-bff-key-the-backend-was-started-with

# The demo school (slug) and its host port for the frontend under test.
E2E_SCHOOL_SLUG=demo
E2E_PORT=3300

# Seeded accounts (Development only).
E2E_ADMIN_IDENTIFIER=admin@demo.example.com
E2E_ADMIN_PASSWORD=replace-with-the-dev-seed-password
E2E_PARENT_PHONE=+2340000000000

# Platform developer: password and TOTP secret (base32). Used only through the API helper.
E2E_PLATFORM_IDENTIFIER=platform.dev@schoolhub.dev.invalid
E2E_PLATFORM_PASSWORD=replace-with-the-dev-seed-password
E2E_PLATFORM_TOTP_SECRET=replace-with-the-base32-totp-secret
