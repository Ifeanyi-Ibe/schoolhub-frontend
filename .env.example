# Copy to .env.local for local development. Never commit real values.
# Full reference: docs/CONFIG.md (written in F9). Every variable is read in src/server/env.ts.

# Base domain for tenant hosts. Production tenants are {slug}.{APP_BASE_DOMAIN}.
# Local dev uses {slug}.localhost:3000 (keep localhost here).
APP_BASE_DOMAIN=localhost

# Public origin of this app (scheme + host + port). Used for absolute links and the Origin check.
APP_ORIGIN=http://localhost:3000

# Base URL of the .NET SchoolHub API (no trailing slash).
API_BASE_URL=http://localhost:5152

# Shared secret the BFF sends to the API as X-Bff-Key. Required. Never log it.
BFF_API_KEY=

# Number of reverse-proxy hops we trust to append X-Forwarded-For. 0 = no proxy in front
# (the client IP is then not forwarded). Set to 1 behind a single proxy.
TRUSTED_PROXY_COUNT=0

# Local dev only: tenant slug used when the host has no school subdomain (for example plain localhost).
# Ignored when NODE_ENV=production.
DEV_TENANT_SLUG=

# Hosts the BFF may stream absolute presigned download URLs from (comma-separated).
# Requests to any other absolute URL are refused (prevents SSRF through the download route).
DOWNLOAD_ALLOWED_HOSTS=
