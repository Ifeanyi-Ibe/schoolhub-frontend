# Copy to .env.local for local development. Never commit real values.
# Every variable is read in src/server/env.ts (validated at first use). Full reference: docs/CONFIG.md (F9).

# Base domain for tenant hosts. Production tenants are {slug}.{APP_BASE_DOMAIN}.
# Local development uses {slug}.localhost:3000 (keep localhost here).
APP_BASE_DOMAIN=localhost

# Public origin of this app (scheme + host + port). Cookie names and the Origin check depend on it:
# https gives the __Host- cookie prefix. Local development is http.
APP_ORIGIN=http://localhost:3000

# Base URL of the .NET SchoolHub API (no trailing slash).
API_BASE_URL=http://localhost:5152

# Shared secret the BFF sends as X-Bff-Key. At least 32 characters, no whitespace (backend ADR 0026).
# Never log it, never send it to a browser.
BFF_API_KEY=

# Must equal the backend's Auth:RefreshGraceSeconds (documented default 10). The BFF reuses a
# refresh result for (grace - 2) seconds at most, so it never presents a rotated token too late.
REFRESH_GRACE_SECONDS=10

# Number of reverse-proxy hops we trust to append X-Forwarded-For. 0 = no proxy in front, so no
# client IP is forwarded. Set to 1 behind a single reverse proxy.
TRUSTED_PROXY_COUNT=0

# Local development only: the school used when the host names none (for example plain localhost).
# Ignored when NODE_ENV=production.
DEV_TENANT_SLUG=

# Hosts the BFF may stream absolute presigned download URLs from (comma-separated). Only HTTPS
# (HTTP outside production) and no credentials. Other hosts are refused (SSRF guard).
DOWNLOAD_ALLOWED_HOSTS=
