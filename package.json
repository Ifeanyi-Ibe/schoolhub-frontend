{
  "name": "schoolhub-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant school management PWA (BFF over the SchoolHub .NET API)",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile-360 --project=desktop",
    "test:e2e:engines": "playwright test --project=webkit --project=firefox",
    "test:e2e:https": "node scripts/e2e-https.mjs",
    "api:gen": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs --check",
    "size": "node scripts/check-bundle-size.mjs",
    "lhci": "lhci autorun --config=lighthouserc.json && lhci autorun --config=lighthouserc.shell.json",
    "gate:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "gate": "npm run gate:fast && npm run api:check && npm run audit:prod && npm run size && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.3.1",
    "@serwist/next": "9.5.13",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "serwist": "9.5.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "otplib": "13.6.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "zod": "4.6.7",
    "postcss": "8.5.33",
    "glob": "14.0.6",
    "minimatch": "11.0.8",
    "basic-ftp": "6.2.6"
  }
}
